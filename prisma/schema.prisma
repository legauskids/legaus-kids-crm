// Legaus Kids CRM — schema Prisma
// Postgres (Neon) em dev e produção — ver DATABASE_URL no .env / painel da Vercel.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StatusConversa {
  FILA
  ATENDENDO
}

enum TipoContato {
  CONTATO
  CLIENTE
  FORNECEDOR
}

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  RECUSADO
  EXPIRADO
}

enum EscopoResposta {
  COMPARTILHADA
  PESSOAL
}

enum StatusMensagemAgendada {
  PENDENTE
  ENVIADA
  CANCELADA
}

enum TipoAtividade {
  NOTA
  WHATSAPP
  SISTEMA
}

enum StatusTarefa {
  A_FAZER
  EM_ANDAMENTO
  APROVACAO
  CONCLUIDA
}

enum TipoEtapa {
  NORMAL
  GANHO
  PERDIDO
}

enum DirecaoMensagem {
  ENTRADA
  SAIDA
}

enum OrigemMensagem {
  MANUAL
  SISTEMA
  WHATSAPP
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  nome         String
  papel        String
  passwordHash String
  apiToken     String?  @unique
  isAdmin      Boolean  @default(false)
  // Chaves ausentes = módulo visível (default aberto). Só entra aqui quando
  // um admin desmarca algo pra alguém — assim usuários existentes não
  // "perdem" acesso por causa da migração.
  permissoes   Json     @default("{}")
  createdAt    DateTime @default(now())

  conversasAtendidas  Conversa[]         @relation("AtendenteConversa")
  negociosResponsavel Negocio[]          @relation("ResponsavelNegocio")
  tarefasResponsavel  Tarefa[]           @relation("ResponsavelTarefa")
  tarefasSolicitadas  Tarefa[]           @relation("SolicitanteTarefa")
  lembretes           Lembrete[]
  respostasRapidas    RespostaRapida[]
  notasInternas       NotaInterna[]
  mensagensEnviadas   Mensagem[]
  atividades          Atividade[]
  orcamentos          Orcamento[]        @relation("ResponsavelOrcamento")
  comandosAgente      ComandoAgente[]
  postagens           Postagem[]
  cotacoes            Cotacao[]
  negociosExcluidos   Negocio[]          @relation("ExclusorNegocio")
}

enum OrigemComando {
  WHATSAPP
  CRM_TEXTO
}

enum StatusComando {
  CONCLUIDO
  AGUARDANDO_CONFIRMACAO
  CANCELADO
  ERRO
}

// Log + "memória de curto prazo" do agente de IA (comando de voz/texto). Uma
// linha com status AGUARDANDO_CONFIRMACAO É o estado pendente: guarda qual
// ferramenta sensível ficou de executar se o usuário confirmar na próxima
// mensagem da mesma origem (telefone no WhatsApp, "crm:<userId>" no CRM).
model ComandoAgente {
  id                   String        @id @default(cuid())
  origem               OrigemComando
  identificador        String
  usuarioId            String?
  usuario              User?         @relation(fields: [usuarioId], references: [id])
  textoComando         String
  resposta             String?
  ferramentaPendente   String?
  argumentosPendentes  Json?
  descricaoPendente    String?
  status               StatusComando @default(CONCLUIDO)
  criadoEm             DateTime      @default(now())

  @@index([identificador, criadoEm])
}

model Setor {
  id        String     @id @default(cuid())
  nome      String     @unique
  conversas Conversa[]
}

model Contato {
  id        String      @id @default(cuid())
  nome      String
  empresa   String?
  telefone  String?     @unique
  tags      String[]    @default([])
  tipo      TipoContato @default(CONTATO)

  // Preenchidos via busca de CNPJ ao cadastrar cliente/fornecedor (pessoa
  // jurídica) — ficam vazios pra um contato pessoa física comum vindo do
  // WhatsApp.
  cnpj              String?
  razaoSocial       String?
  inscricaoEstadual String?
  endereco          String?
  cidade            String?
  uf                String?
  cep               String?
  email             String?

  // Quem assina pela empresa — precisa pro contrato, não é revelado pela
  // busca de CNPJ (sigilo), então é preenchido manualmente.
  representanteLegalNome String?
  representanteLegalCpf  String?

  createdAt DateTime @default(now())

  conversas  Conversa[]
  negocios   Negocio[]
  tarefas    Tarefa[]
  orcamentos Orcamento[]
}

model Conversa {
  id          String         @id @default(cuid())
  contatoId   String
  contato     Contato        @relation(fields: [contatoId], references: [id])
  setorId     String
  setor       Setor          @relation(fields: [setorId], references: [id])
  atendenteId String?
  atendente   User?          @relation("AtendenteConversa", fields: [atendenteId], references: [id])
  status      StatusConversa @default(FILA)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  mensagens          Mensagem[]
  notas              NotaInterna[]
  mensagensAgendadas MensagemAgendada[]
  negociosOrigem     Negocio[]          @relation("OrigemConversaNegocio")
  tarefas            Tarefa[]
}

model Mensagem {
  id          String          @id @default(cuid())
  conversaId  String
  conversa    Conversa        @relation(fields: [conversaId], references: [id])
  direcao     DirecaoMensagem
  origem      OrigemMensagem  @default(MANUAL)
  texto       String
  autorUserId String?
  autor       User?           @relation(fields: [autorUserId], references: [id])
  externalId  String?         @unique
  enviadaEm   DateTime        @default(now())
  anexoUrl       String?
  anexoNome      String?
  anexoMimetype  String?
}

model NotaInterna {
  id         String   @id @default(cuid())
  conversaId String
  conversa   Conversa @relation(fields: [conversaId], references: [id])
  autorId    String
  autor      User     @relation(fields: [autorId], references: [id])
  texto      String
  criadaEm   DateTime @default(now())
}

model MensagemAgendada {
  id           String                 @id @default(cuid())
  conversaId   String
  conversa     Conversa               @relation(fields: [conversaId], references: [id])
  texto        String
  agendadaPara DateTime
  status       StatusMensagemAgendada @default(PENDENTE)
  criadaPorId  String
  criadaEm     DateTime               @default(now())
}

model Funil {
  id       String    @id @default(cuid())
  nome     String
  ordem    Int       @default(0)
  etapas   Etapa[]
  negocios Negocio[]
}

model Etapa {
  id       String    @id @default(cuid())
  funilId  String
  funil    Funil     @relation(fields: [funilId], references: [id])
  nome     String
  ordem    Int
  slaDias  Int?
  tipo     TipoEtapa @default(NORMAL)
  negocios Negocio[]
}

model Negocio {
  id                 String    @id @default(cuid())
  titulo             String
  produto            String?
  descricao          String?
  contatoId          String?
  contato            Contato?  @relation(fields: [contatoId], references: [id])
  funilId            String
  funil              Funil     @relation(fields: [funilId], references: [id])
  etapaId            String
  etapa              Etapa     @relation(fields: [etapaId], references: [id])
  valorCentavos      Int       @default(0)
  responsavelId      String
  responsavel        User      @relation("ResponsavelNegocio", fields: [responsavelId], references: [id])
  dataInicio         DateTime  @default(now())
  dataEntradaNaEtapa DateTime  @default(now())
  previsaoFechamento DateTime?
  origem             String?
  progressoProducao  Int?
  previsaoProducao   DateTime?
  dataInstalacao     DateTime?
  equipeInstalacao   String?
  motivoPerda        String?
  formaPagamento     String?
  origemConversaId   String?
  origemConversa     Conversa? @relation("OrigemConversaNegocio", fields: [origemConversaId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Exclusão é sempre um soft-delete com justificativa obrigatória — nunca
  // apaga a linha de verdade, só tira de toda listagem/board/dashboard (ver
  // a extensão do Prisma Client em lib/db.ts que já filtra excluidoEm: null
  // automaticamente em findMany/findFirst/count de Negocio).
  excluidoEm     DateTime?
  motivoExclusao String?
  excluidoPorId  String?
  excluidoPor    User?     @relation("ExclusorNegocio", fields: [excluidoPorId], references: [id])

  tarefas    Tarefa[]
  atividades Atividade[]
  contratos  Contrato[]
}

// Texto único e editável usado como base pra gerar cada contrato — Marcos
// edita esse "modelo padrão" na aba Contratos do Financeiro, com campos tipo
// {{cliente_nome}} que são preenchidos na hora de gerar. Fica só um registro
// "ativo" por vez; histórico de versões não é necessário pro escopo atual.
model ModeloContrato {
  id           String   @id @default(cuid())
  titulo       String   @default("Modelo padrão")
  conteudo     String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum StatusContrato {
  GERADO
  ENVIADO
  ASSINADO
  CANCELADO
}

// Snapshot imutável do texto já mesclado no momento da geração — editar o
// ModeloContrato depois não muda contratos já gerados, só os próximos.
model Contrato {
  id           String         @id @default(cuid())
  numero       Int            @unique @default(autoincrement())
  negocioId    String
  negocio      Negocio        @relation(fields: [negocioId], references: [id])
  conteudo     String
  status       StatusContrato @default(GERADO)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
}

model Tarefa {
  id            String       @id @default(cuid())
  titulo        String
  negocioId     String?
  negocio       Negocio?     @relation(fields: [negocioId], references: [id])
  contatoId     String?
  contato       Contato?     @relation(fields: [contatoId], references: [id])
  conversaId    String?
  conversa      Conversa?    @relation(fields: [conversaId], references: [id])
  responsavelId String
  responsavel   User         @relation("ResponsavelTarefa", fields: [responsavelId], references: [id])
  solicitanteId String
  solicitante   User         @relation("SolicitanteTarefa", fields: [solicitanteId], references: [id])
  prazo         DateTime
  status        StatusTarefa @default(A_FAZER)
  descricao     String?
  automatica    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lembretes Lembrete[]
}

model Lembrete {
  id            String    @id @default(cuid())
  paraUsuarioId String
  paraUsuario   User      @relation(fields: [paraUsuarioId], references: [id])
  nome          String
  descricao     String?
  notificarEm   DateTime?
  tarefaId      String?
  tarefa        Tarefa?   @relation(fields: [tarefaId], references: [id])
  lido          Boolean   @default(false)
  criadoEm      DateTime  @default(now())
}

model RespostaRapida {
  id     String         @id @default(cuid())
  titulo String
  texto  String
  escopo EscopoResposta
  donoId String?
  dono   User?          @relation(fields: [donoId], references: [id])
}

model Atividade {
  id        String        @id @default(cuid())
  negocioId String
  negocio   Negocio       @relation(fields: [negocioId], references: [id])
  tipo      TipoAtividade
  texto     String
  autorId   String?
  autor     User?         @relation(fields: [autorId], references: [id])
  criadoEm  DateTime      @default(now())
}

model Meta {
  id                String @id @default(cuid())
  mes               Int
  ano               Int
  valorAlvoCentavos Int

  @@unique([mes, ano])
}

model Catalogo {
  id       String   @id @default(cuid())
  nome     String
  url      String
  criadoEm DateTime @default(now())
}

model Produto {
  id            String   @id @default(cuid())
  nome          String
  codigo        String?
  categoria     String
  descricao     String?
  imagemUrl     String?
  valorCentavos Int?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Planilha de custo/margem (guia "Lista de preços" em Cadastros). Preço de
  // venda continua sendo valorCentavos — calculado a partir do markup aqui,
  // pra manter uma fonte única usada também no Orçamento.
  custoCompraCentavos Int?
  freteCustoCentavos  Int?
  ipiCustoCentavos    Int?
  outrosCustoCentavos Int?
  quantidadeReferencia Int   @default(1)
  markupPercentual    Float?
  impostoPercentual   Float?
  instalacaoCentavos  Int?

  orcamentoItens OrcamentoItem[]

  @@index([categoria])
}

model Orcamento {
  id               String          @id @default(cuid())
  numero           Int             @unique @default(autoincrement())
  contatoId        String?
  contato          Contato?        @relation(fields: [contatoId], references: [id])
  responsavelId    String
  responsavel      User            @relation("ResponsavelOrcamento", fields: [responsavelId], references: [id])
  status           StatusOrcamento @default(RASCUNHO)
  validadeDias     Int             @default(15)
  observacoes      String?
  descontoCentavos Int             @default(0)
  tokenPublico     String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  itens OrcamentoItem[]
}

model OrcamentoItem {
  id                    String    @id @default(cuid())
  orcamentoId           String
  orcamento             Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produtoId             String?
  produto               Produto?  @relation(fields: [produtoId], references: [id])
  nome                  String
  descricao             String?
  quantidade            Int       @default(1)
  valorUnitarioCentavos Int       @default(0)
  ordem                 Int       @default(0)
}

// ---------------------------------------------------------------------------
// Marketing — postagens (Instagram/Facebook/Status do WhatsApp). Fotos ficam
// guardadas como bytes no próprio Postgres (mesma ideia do PDF gerado sob
// demanda: sem depender de um serviço de storage externo pra funcionar hoje).
// ---------------------------------------------------------------------------

enum TipoPostagem {
  FEED_INSTAGRAM
  STORY_INSTAGRAM
  STATUS_WHATSAPP
  FEED_FACEBOOK
}

enum StatusPostagem {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADO
  PUBLICADO
  RECUSADO
}

model ModeloPostagem {
  id            String   @id @default(cuid())
  titulo        String
  tipo          TipoPostagem
  legendaModelo String
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}

// Uma Postagem pode ter várias fotos (carrossel) — cada foto tem 2-3
// variantes de layout de marca geradas de uma vez, e uma delas fica marcada
// como escolhida. Edição por IA substitui a "original" da foto e regenera
// as variantes.
model Postagem {
  id           String         @id @default(cuid())
  numero       Int            @unique @default(autoincrement())
  tipo         TipoPostagem
  status       StatusPostagem @default(AGUARDANDO_APROVACAO)
  contexto     String?
  headline     String?
  legenda      String?
  criadoPorId  String
  criadoPor    User           @relation(fields: [criadoPorId], references: [id])
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  imagens PostagemImagem[]
}

model PostagemImagem {
  id                 String   @id @default(cuid())
  postagemId         String
  postagem           Postagem @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  ordem              Int      @default(0)
  imagemOriginal     Bytes
  imagemOriginalMime String   @default("image/jpeg")
  criadoEm           DateTime @default(now())

  variantes PostagemImagemVariante[]
}

enum LayoutVariante {
  FAIXA
  CANTO
  LATERAL
}

model PostagemImagemVariante {
  id               String         @id @default(cuid())
  postagemImagemId String
  postagemImagem   PostagemImagem @relation(fields: [postagemImagemId], references: [id], onDelete: Cascade)
  layout           LayoutVariante
  escolhida        Boolean        @default(false)
  imagem           Bytes
  imagemMime       String         @default("image/jpeg")
  criadoEm         DateTime       @default(now())
}

enum TipoCotacao {
  PLAYGROUND
  KIDPLAY
  BRINQUEDOS
  OUTROS
}

// Calculadora de custo/margem por categoria (aba "Cotações" em Cadastros) —
// reconstrução das planilhas Excel que o Marcos já usa pra precificar um
// playground/kidplay sob medida: itens agrupados por seção (torre, conexão,
// subidas...), mais um painel de resumo (mão de obra, markup, instalação,
// frete, imposto) que calcula o preço de venda e a margem. Diferente do
// Orçamento (documento formal pro cliente): aqui é a ferramenta de cálculo
// interna, antes de virar proposta.
model Cotacao {
  id     String        @id @default(cuid())
  numero Int           @unique @default(autoincrement())
  tipo   TipoCotacao
  titulo String
  itens  CotacaoItem[]

  // Mão de obra varia em quantidade de campos por tipo (Playground tem 1,
  // Kidplay tem 2 — "TL" e "Estofador") — guardado como
  // [{ label: string, valorCentavos: number }].
  maoDeObra               Json     @default("[]")
  markup                  Float    @default(1.9)
  adicionalCentavos       Int      @default(0)
  instalacaoPercentual    Float    @default(5)
  freteKm                 Float    @default(0)
  fretePrecoPorKmCentavos Int      @default(500)
  impostoCentavos         Int      @default(0)

  criadoPorId  String
  criadoPor    User     @relation(fields: [criadoPorId], references: [id])
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([tipo])
}

model CotacaoItem {
  id                    String  @id @default(cuid())
  cotacaoId             String
  cotacao               Cotacao @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  secao                 String
  nome                  String
  quantidade            Float   @default(0)
  custoUnitarioCentavos Int     @default(0)
  ordem                 Int     @default(0)

  // Só usados no modo "por item" (tipo OUTROS) — projetos maiores com itens
  // variados, onde cada linha tem seu próprio markup/frete/instalação/
  // imposto, em vez de um resumo único pro projeto inteiro como em
  // Playground/Kidplay.
  antecipacaoIcmsPercentual Float @default(0)
  freteCentavos             Int   @default(0)
  instalacaoCentavos        Int   @default(0)
  markup                    Float @default(1.9)
  impostoPercentual         Float @default(7)

  @@index([cotacaoId])
}
