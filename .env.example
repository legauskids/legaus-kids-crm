DATABASE_URL="file:./dev.db"
SESSION_SECRET="generate-a-random-secret-here"

# Senhas de dev seedadas (só para ambiente local)
SEED_DANI_PASSWORD="dani123"
SEED_MARCOS_PASSWORD="marcos123"

# Emissão de Nota Fiscal (Focus NFe, https://doc.focusnfe.com.br/) — deixe
# tudo em branco pra manter a emissão desativada (o botão "Emitir Nota
# Fiscal" continua funcionando pra deixar a nota rascunhada, só não manda
# de verdade pra Focus NFe até isso ser preenchido). Precisa de: conta na
# Focus NFe (tem teste grátis de 30 dias) + certificado digital e-CNPJ
# modelo A1 (comprado numa certificadora, não é a Focus NFe que vende).
FOCUS_NFE_API_TOKEN=
# "homologacao" (padrão, ambiente de teste da SEFAZ, não gera nota de
# verdade) ou "producao" — só trocar pra produção depois de testar.
FOCUS_NFE_AMBIENTE=homologacao

# Dados cadastrais da Legaus Kids como emitente da nota — vêm do cartão
# CNPJ e do registro na Sefaz do estado (inscrição estadual).
EMPRESA_CNPJ=
EMPRESA_RAZAO_SOCIAL=
EMPRESA_NOME_FANTASIA=
EMPRESA_INSCRICAO_ESTADUAL=
# 1 = Simples Nacional, 2 = Simples Nacional (excesso de sublimite), 3 = Regime Normal — confirme com o contador.
EMPRESA_REGIME_TRIBUTARIO=
EMPRESA_LOGRADOURO=
EMPRESA_NUMERO=
EMPRESA_BAIRRO=
EMPRESA_MUNICIPIO=
EMPRESA_UF=
EMPRESA_CEP=
