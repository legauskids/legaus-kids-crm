# URL do CRM (produção por padrão; troque por http://localhost:3000 só se
# estiver testando contra o CRM rodando localmente).
CRM_API_URL=https://crm.legauskids.com.br

# Token de acesso do usuário — gerado em /extensao dentro do CRM (mesmo
# token que a extensão de Chrome usa). Copie e cole aqui.
CRM_API_TOKEN=

# Opcional: preencha com o número do WhatsApp Business (só dígitos, com
# DDI, ex.: 5555999999999) pra parear com um CÓDIGO de 8 dígitos em vez de
# escanear QR code — mais fácil quando o QR expira antes de dar tempo de
# escanear. Deixe em branco pra usar QR code normalmente.
WHATSAPP_PAREAMENTO_TELEFONE=

# Comando pro agente de IA por voz, texto ou PDF: números autorizados (só
# dígitos, com DDI, separados por vírgula — ex: 5555999999999,5555988888888).
# Inclua tanto seu número pessoal (pra mandar comando PRO WhatsApp da Legaus
# a partir do seu celular) quanto, se quiser, outro número autorizado. Vale
# nas duas direções: mensagem de um número da lista PRA Legaus Kids vira
# comando, e mensagem da Legaus Kids PRO número (self-chat, "gravando e
# mandando pra si mesmo") também vira comando, contanto que esse número
# esteja na lista. Mensagem de/pra QUALQUER OUTRO número (ex: conversa real
# com cliente) NUNCA vira comando — só é ignorada pelo agente, a mensagem
# continua indo pro Atendimento normalmente.
WHATSAPP_COMANDO_TELEFONES=

# Além da lista acima, mandar uma mensagem de TEXTO (ou PDF com legenda)
# pro WhatsApp da Legaus Kids contendo a palavra "agente" (em qualquer
# lugar da frase) também vira comando, mesmo de um número fora da lista —
# não depende de manter o número exato de cada aparelho atualizado. Só vale
# no sentido "pra Legaus Kids" (nunca "Legaus Kids -> alguém", senão
# mencionar "agente" numa conversa de verdade com cliente viraria comando
# por engano) e não vale pra nota de voz (precisaria transcrever antes de
# saber se tem a palavra, então voz continua só pelos números da lista
# acima).
