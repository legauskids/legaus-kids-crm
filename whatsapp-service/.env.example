# URL do CRM (produção por padrão; troque por http://localhost:3000 só se
# estiver testando contra o CRM rodando localmente).
CRM_API_URL=https://crm.legauskids.com.br

# Token de acesso do usuário — gerado em /extensao dentro do CRM (mesmo
# token que a extensão de Chrome usa). Copie e cole aqui.
CRM_API_TOKEN=

# Opcional: preencha com o número do WhatsApp Business (só dígitos, com
# DDI, ex.: 5555999999999) pra parear com um CÓDIGO de 8 dígitos em vez de
# escanear QR code — mais fácil quando o QR expira antes de dar tempo de
# escanear. Deixe em branco pra usar QR code normalmente.
WHATSAPP_PAREAMENTO_TELEFONE=
